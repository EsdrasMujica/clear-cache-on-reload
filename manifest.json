{
  "manifest_version": 3,
  "name": "CCoR - Clear Cache on Reload",
  "short_name": "CCoR",
  "version": "2.0.0",
  "description": "CCoR: borra caché, cookies y storage de los sitios que elijas al recargar. Lista permitida y bloqueada.",
  "permissions": ["storage", "webNavigation", "browsingData", "scripting", "cookies", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CCoR - Clear Cache on Reload",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "commands": {
    "toggle-ccor": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Activar o desactivar CCoR"
    }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" }
}
