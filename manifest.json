{
  "manifest_version": 3,
  "name": "Clear Cache on Reload (Dev)",
  "version": "1.0.0",
  "description": "Borra automáticamente caché, cookies y storage de localhost (y dominios configurados) cada vez que recargas la página. Ideal para desarrollo.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "browsingData",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clear Cache on Reload",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
